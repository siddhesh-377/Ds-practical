      "text": "Theory :"
    },
    {
      "style": "Normal",
      "text": "Linear Search: A sequential search where each element is checked one by one until the desired element is found."
    },
    {
      "style": "Normal",
      "text": "Linear Search Algorithm"
    },
    {
      "style": "Normal",
      "text": "Start"
    },
    {
      "style": "Normal",
      "text": "Input array elements and target value"
    },
    {
      "style": "Normal",
      "text": "Traverse the array from index 0 to n-1"
    },
    {
      "style": "Normal",
      "text": "If element matches target, return FOUND"
    },
    {
      "style": "Normal",
      "text": "Else continue"
    },
    {
      "style": "Normal",
      "text": "If not found, return NOT FOUND"
    },
    {
      "style": "Normal",
      "text": "Stop"
    },
    {
      "style": "Normal",
      "text": ""
    },
    {
      "style": "Normal",
      "text": "Flow Chart for Linear Search:"
    },
    {
      "style": "Normal",
      "text": ""
    },
    {
      "style": "Normal",
      "text": ""
    },
    {
      "style": "Normal",
      "text": "Binary Search: A divide-and-conquer approach which requires the data to be sorted. It reduces the search space in half each time."
    },
    {
      "style": "Normal",
      "text": "Binary Search Algorithm"
    },
    {
      "style": "Normal",
      "text": "Start"
    },
    {
      "style": "Normal",
      "text": "Input sorted array and key value"
    },
    {
      "style": "Normal",
      "text": "Set low = 0 and high = n - 1"
    },
    {
      "style": "Normal",
      "text": "While low ≤ high:"
    },
    {
      "style": "Normal",
      "text": "Compute mid = (low + high) / 2"
    },
    {
      "style": "Normal",
      "text": "If array[mid] == key, return FOUND"
    },
    {
      "style": "Normal",
      "text": "Else if key < array[mid], set high = mid - 1"
    },
    {
      "style": "Normal",
      "text": "Else set low = mid + 1"
    },
    {
      "style": "Normal",
      "text": "If loop exits, return NOT FOUND"
    },
    {
      "style": "Normal",
      "text": "Stop"
    },
    {
      "style": "Normal",
      "text": ""
    },
    {
      "style": "Normal",
      "text": ""
