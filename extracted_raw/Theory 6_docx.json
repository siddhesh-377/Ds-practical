    {
      "style": "Normal",
      "text": "Algorithm to check well formedness of parenthesis"
    },
    {
      "style": "List Paragraph",
      "text": "Declare a character stack S."
    },
    {
      "style": "List Paragraph",
      "text": "Now traverse the expression string exp."
    },
    {
      "style": "List Paragraph",
      "text": "If the current character is a starting bracket („(„ or „{„ or „[„) then push it to stack."
    },
    {
      "style": "List Paragraph",
      "text": "If the current character is a closing bracket („)‟ or „}‟ or „]‟) then pop from stack and if the popped character is the matching starting bracket then fine else parenthesis are not balanced."
    },
    {
      "style": "List Paragraph",
      "text": "After complete traversal, if there is some starting bracket left in stack then “not balanced”"
    },
    {
      "style": "Body Text",
      "text": ""
    },
