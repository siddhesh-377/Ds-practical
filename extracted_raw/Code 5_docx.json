    },
    {
      "style": "Normal",
      "text": ""
    },
    {
      "style": "Normal",
      "text": "    do"
    },
    {
      "style": "Normal",
      "text": "    {"
    },
    {
      "style": "Normal",
      "text": "        cout << \"\\n1. Free Slots\";"
    },
    {
      "style": "Normal",
      "text": "        cout << \"\\n2. Book Appointment\";"
    },
    {
